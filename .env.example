# ==============================================================================
# TAMYIZ™ Digital Publishing & Design Systems Studio — Environment Configuration
# ==============================================================================

# 1. Razorpay Payment Gateway Credentials (Live / Test)
# Leave empty or omit during development to automatically activate the Smart Sandbox Simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 2. Resend Transactional Email API (Automated PDF/Notion License Dispatch)
# Optional: If unset, digital download links are delivered instantaneously on-screen.
RESEND_API_KEY=

# 3. Direct Digital Download & Notion 1-Click Duplication Vault URLs
# Fallbacks are configured in api/_utils.js; override here for private cloud storage buckets / Notion spaces.
URL_MONOGRAPH_BUNDLE=https://assets.tamyiz.in/downloads/tamyiz-monograph-01-bundle.zip
URL_MONOGRAPH_EPUB=https://assets.tamyiz.in/downloads/tamyiz-monograph-01-kindle.epub
URL_BLUEPRINT_PDF=https://assets.tamyiz.in/downloads/zero-to-one-blueprint-bundle.zip
URL_BLUEPRINT_EPUB=https://assets.tamyiz.in/downloads/zero-to-one-blueprint.epub
URL_NOTION_MATRIX=https://tamyiz.notion.site/TAMYIZ-Academic-Research-Literature-Matrix-duplicate-v1
URL_NOTION_STUDENT=https://tamyiz.notion.site/TAMYIZ-Academic-Research-Student-duplicate-v1
